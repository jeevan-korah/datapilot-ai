# Copy this file to .env and fill in real values. Never commit .env.

# Prisma Postgres connection string (the app's own database is also the query target)
DATABASE_URL=

# AES-256-GCM key used to encrypt stored DB connection strings — keep the same value across restarts
ENCRYPTION_KEY=

# Nodemailer SMTP (Gmail app password). Email failures are non-fatal.
GMAIL_USER=
GMAIL_PASS=

# Groq LLM for SQL generation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Signing secret for JWTs
JWT_SECRET=

# Optional: comma-separated CORS allowlist. Omit to use the built-in localhost + previous deploy defaults.
# CORS_ORIGINS=https://myapp.vercel.app,http://localhost:5173

# Port (Render injects PORT automatically)
PORT=5050